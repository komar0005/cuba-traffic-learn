<?xml version="1.0" encoding="utf-8"?>
<!-- El progreso del estudiante vive en el almacenamiento local del WebView:
     se incluye en las copias de seguridad para no perderlo al cambiar de teléfono. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" />
    </device-transfer>
</data-extraction-rules>
